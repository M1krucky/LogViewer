<Window x:Class="LogViewer.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Background="#1E1E1E"
        Foreground="White"
        Title="Statistics"
        Height="700"
        Width="900">

    <!-- ========================================================= -->
    <!-- Statistics Window Layout -->
    <!-- ========================================================= -->

    <!-- Provides consistent spacing around all statistics content. -->
    <Grid Margin="20">

        <!--
            Row 0: Summary statistics
            Row 1: Vertical spacing
            Row 2: Log-level distribution chart
            Row 3: Vertical spacing
            Row 4: Error-trend chart
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- Summary Statistics -->
        <!-- ===================================================== -->

        <!-- Displays summary values for the currently visible log entries. -->
        <Grid Grid.Row="0">

            <!-- Statistic labels and corresponding values -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- One row for each displayed statistic -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Total entries -->
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       FontSize="15"
                       Text="Total entries:" />

            <TextBlock Name="TotalEntriesTextBlock"
                       Grid.Row="0"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="0" />

            <!-- INFO entries -->
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       FontSize="15"
                       Foreground="SteelBlue"
                       FontWeight="SemiBold"
                       Text="INFO:" />

            <TextBlock Name="InfoCountTextBlock"
                       Grid.Row="1"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="0" />

            <!-- WARNING entries -->
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       FontSize="15"
                       Foreground="#B46E00"
                       FontWeight="SemiBold"
                       Text="WARNING:" />

            <TextBlock Name="WarningCountTextBlock"
                       Grid.Row="2"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="0" />

            <!-- ERROR entries -->
            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       FontSize="15"
                       Foreground="Red"
                       FontWeight="SemiBold"
                       Text="ERROR:" />

            <TextBlock Name="ErrorCountTextBlock"
                       Grid.Row="3"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="0" />

            <!-- Latest visible log timestamp -->
            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       FontSize="15"
                       Text="Latest log:" />

            <TextBlock Name="LatestLogTextBlock"
                       Grid.Row="4"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="-" />

        </Grid>

        <!-- ===================================================== -->
        <!-- Log-Level Distribution -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="2">

            <!-- Section title -->
            <TextBlock Text="Log Level Distribution"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,6" />

            <!-- Displays INFO, WARNING, and ERROR counts as columns. -->
            <lvc:CartesianChart Height="225"
                                Background="Transparent"
                                Series="{Binding LogLevelSeries}"
                                XAxes="{Binding LogLevelXAxes}"
                                YAxes="{Binding LogLevelYAxes}" />

        </StackPanel>

        <!-- ===================================================== -->
        <!-- Error Trend -->
        <!-- ===================================================== -->

        <!-- Uses the remaining window space for the trend chart. -->
        <Grid Grid.Row="4">

            <!-- Header and expandable chart area -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- =============================================== -->
            <!-- Error Trend Header -->
            <!-- =============================================== -->

            <!-- Displays the chart title and grouping selector. -->
            <DockPanel Grid.Row="0"
                       Margin="0,0,0,-5">

                <TextBlock Text="Error Trend"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />

                <!-- Time-grouping controls -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">

                    <TextBlock Text="Group by:"
                               Margin="20,0,5,0"
                               VerticalAlignment="Center" />

                    <!-- Groups ERROR entries by the selected time period. -->
                    <ComboBox Name="ErrorTrendGroupingComboBox"
                              Width="90"
                              SelectedIndex="1"
                              VerticalContentAlignment="Center"
                              SelectionChanged="ErrorTrendGroupingComboBox_SelectionChanged">

                        <ComboBoxItem Content="Hour" />
                        <ComboBoxItem Content="Day" />
                        <ComboBoxItem Content="Week" />
                        <ComboBoxItem Content="Month" />

                    </ComboBox>

                </StackPanel>

            </DockPanel>

            <!-- =============================================== -->
            <!-- Error Trend Chart -->
            <!-- =============================================== -->

            <!-- Displays the number of ERROR entries over time. -->
            <lvc:CartesianChart Grid.Row="1"
                                Background="Transparent"
                                Series="{Binding ErrorTrendSeries}"
                                XAxes="{Binding ErrorTrendXAxes}"
                                YAxes="{Binding ErrorTrendYAxes}" />

        </Grid>

    </Grid>

</Window>