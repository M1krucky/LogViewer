<Window x:Class="LogViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LogViewer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Style="{StaticResource DarkWindowStyle}"
        Title="LogViewer"
        Height="550"
        Width="1070"
        WindowStyle="None">

    <!-- ========================================================= -->
    <!-- Custom Window Frame -->
    <!-- ========================================================= -->

    <!-- Enables native resizing while using a custom title bar. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- ========================================================= -->
    <!-- Main Window Layout -->
    <!-- ========================================================= -->

    <DockPanel>

        <!-- ===================================================== -->
        <!-- Custom Title Bar -->
        <!-- ===================================================== -->

        <controls:TitleBar DockPanel.Dock="Top"
                           Title="LogViewer" />

        <!-- ===================================================== -->
        <!-- Application Menu -->
        <!-- ===================================================== -->

        <!-- Provides file-management and application-help commands. -->
        <Menu DockPanel.Dock="Top">

            <!-- File operations -->
            <MenuItem Header="_File"
                      Style="{StaticResource TopMenuItemStyle}">

                <MenuItem Header="_Open Log File..."
                          Click="OpenFileButton_Click" />

                <Separator />

                <!-- Populated dynamically with recently opened files. -->
                <MenuItem x:Name="RecentFilesMenuItem"
                          Header="_Recent Files" />

                <Separator />

                <!-- Exports the currently filtered log entries. -->
                <MenuItem Header="_Export CSV..."
                          Click="ExportButton_Click" />

                <Separator />

                <MenuItem Header="E_xit"
                          Click="ExitMenuItem_Click" />

            </MenuItem>

            <!-- Help and application information -->
            <MenuItem Header="_Help"
                      Style="{StaticResource TopMenuItemStyle}">

                <MenuItem Header="_About"
                          Click="AboutMenuItem_Click" />

            </MenuItem>

        </Menu>

        <!-- ===================================================== -->
        <!-- Status Bar -->
        <!-- ===================================================== -->

        <!-- Displays the path of the currently opened log file. -->
        <StatusBar DockPanel.Dock="Bottom">

            <StatusBarItem>

                <TextBlock x:Name="CurrentFileTextBlock"
                           Text="File: No file opened" />

            </StatusBarItem>

        </StatusBar>

        <!-- ===================================================== -->
        <!-- Main Content Area -->
        <!-- ===================================================== -->

        <Grid>

            <!--
                Row 0: Toolbar and filters
                Row 1: Log entries table
                Row 2: Selected-entry details and loading status
            -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- Toolbar and Filters -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="10,8">

                <!-- File action -->
                <Button Name="OpenFileButton"
                        Width="82"
                        Click="OpenFileButton_Click">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="&#xE8E5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center" />

                        <TextBlock Text="Open"
                                   VerticalAlignment="Center" />

                    </StackPanel>

                </Button>

                <!-- Statistics action -->
                <Button Name="StatisticsButton"
                        Width="110"
                        Click="StatisticsButton_Click">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="&#xE9D2;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center" />

                        <TextBlock Text="Statistics"
                                   VerticalAlignment="Center" />

                    </StackPanel>

                </Button>

                <!-- Search text -->
                <TextBlock Text="Search:"
                           Margin="20,0,5,0"
                           VerticalAlignment="Center" />

                <TextBox Name="SearchTextBox"
                         Width="200"
                         TextChanged="SearchTextBox_TextChanged" />

                <!-- Determines whether any or all search terms must match. -->
                <ComboBox Name="SearchModeComboBox"
                          Width="70"
                          Margin="5,0,0,0"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center"
                          SelectionChanged="SearchModeComboBox_SelectionChanged">

                    <ComboBoxItem Content="OR" />
                    <ComboBoxItem Content="AND" />

                </ComboBox>

                <!-- Log-level filter -->
                <TextBlock Text="Level:"
                           Margin="10,0,5,0"
                           VerticalAlignment="Center" />

                <ComboBox Name="LevelFilterComboBox"
                          Width="100"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center"
                          SelectionChanged="LevelFilterComboBox_SelectionChanged">

                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="INFO" />
                    <ComboBoxItem Content="WARNING" />
                    <ComboBoxItem Content="ERROR" />

                </ComboBox>

                <!-- Start-date filter -->
                <TextBlock Text="From:"
                           Margin="10,0,5,0"
                           VerticalAlignment="Center" />

                <DatePicker Name="FromDatePicker"
                            Width="120"
                            VerticalAlignment="Center"
                            SelectedDateChanged="DatePicker_SelectedDateChanged" />

                <!-- End-date filter -->
                <TextBlock Text="To:"
                           Margin="10,0,5,0"
                           VerticalAlignment="Center" />

                <DatePicker Name="ToDatePicker"
                            Width="120"
                            VerticalAlignment="Center"
                            SelectedDateChanged="DatePicker_SelectedDateChanged" />

            </StackPanel>

            <!-- ================================================= -->
            <!-- Log Entries Table -->
            <!-- ================================================= -->

            <!-- Displays the parsed log entries after active filters are applied. -->
            <DataGrid Name="LogGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionChanged="LogGrid_SelectionChanged">

                <!-- Severity-based row highlighting -->
                <DataGrid.RowStyle>

                    <Style TargetType="DataGridRow">

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding Level}"
                                         Value="ERROR">

                                <Setter Property="Background"
                                        Value="{StaticResource ErrorRowBrush}" />

                            </DataTrigger>

                            <DataTrigger Binding="{Binding Level}"
                                         Value="WARNING">

                                <Setter Property="Background"
                                        Value="{StaticResource WarningRowBrush}" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </DataGrid.RowStyle>

                <!-- Log-entry columns -->
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Timestamp"
                                        Binding="{Binding Timestamp}" />

                    <DataGridTextColumn Header="Level"
                                        Binding="{Binding Level}" />

                    <DataGridTextColumn Header="Message"
                                        Binding="{Binding Message}" />

                </DataGrid.Columns>

            </DataGrid>

            <!-- ================================================= -->
            <!-- Selected Log Entry Details -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Margin="10"
                    Padding="10"
                    BorderBrush="LightGray"
                    BorderThickness="1">

                <StackPanel>

                    <!-- Details heading -->
                    <TextBlock Text="Selected Log Details"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,10" />

                    <!-- Selected timestamp -->
                    <TextBlock Name="SelectedTimestampTextBlock"
                               Text="Timestamp: -"
                               Margin="0,0,0,5" />

                    <!-- Selected severity level -->
                    <TextBlock Name="SelectedLevelTextBlock"
                               Text="Level: -"
                               Margin="0,0,0,5" />

                    <!-- Selected log message -->
                    <TextBlock Name="SelectedMessageTextBlock"
                               Text="Message: -"
                               TextWrapping="Wrap" />

                    <!-- ========================================= -->
                    <!-- Loading Indicator -->
                    <!-- ========================================= -->

                    <!-- Hidden until a log file is being loaded. -->
                    <StackPanel x:Name="LoadingPanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                Margin="0,8,0,8">

                        <ProgressBar Width="160"
                                     Height="16"
                                     IsIndeterminate="True"
                                     Margin="0,0,10,0" />

                        <TextBlock Text="Loading log file..."
                                   VerticalAlignment="Center" />

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </DockPanel>

</Window>